APP_NAME="Peblar Load Balancer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# Default path = database/database.sqlite (auto-created)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================
# Peblar laadpaal — vereist
# ==============================================================
# IP-adres van de Peblar in je LAN
PEBLAR_IP=
# API token uit Peblar webinterface (Local API -> Authentication)
PEBLAR_TOKEN=

# ==============================================================
# Smart meter (Slimmelezer P1) — vereist
# ==============================================================
P1_IP=

# ==============================================================
# Solax omvormer — optioneel (laat leeg als geen omvormer)
# ==============================================================
SOLAX_IP=
# Solax wachtwoord = serienummer omvormer
SOLAX_PASSWORD=

# ==============================================================
# Zonneplan dynamische prijzen — optioneel
# ==============================================================
ZONNEPLAN_USERNAME=
ZONNEPLAN_PASSWORD=

# ==============================================================
# Hyundai BlueLink (Ioniq 5 etc.) — optioneel
# ==============================================================
# CLIENT_ID en CLIENT_SECRET zijn reverse-engineered constanten uit de
# publieke BlueLink mobile app. Niet inbegrepen in deze repo.
#
# Vind ze in de Hyundai-Kia-Connect community library:
#   https://github.com/Hyundai-Kia-Connect/hyundai_kia_connect_api
#   - EU-regio: zoek "CLIENT_ID" in HyundaiBlueLinkAPIEUROPE.py
#   - andere regio's: KiaUvoApiEU.py / HyundaiBlueLinkAPIUSA.py / etc.
#
# Of decompile zelf de officiele BlueLink Android app (.apk) en haal
# client_id + client_secret uit de OAuth-config.
HYUNDAI_CLIENT_ID=
HYUNDAI_CLIENT_SECRET=
HYUNDAI_REDIRECT_URI=https://prd.eu-ccapi.hyundai.com:8080/api/v1/user/oauth2/token

# ==============================================================
# Load balancer parameters
# ==============================================================
MAX_CHARGE_POWER_W=11000
GRID_CAPACITY_W=25000
GRID_BUFFER_W=500
PHASE_COUNT=3
