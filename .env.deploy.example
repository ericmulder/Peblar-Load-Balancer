# Configuratie voor deploy.sh
# Kopieer naar .env.deploy (gitignored) en vul je eigen server in.

# SSH-doel: user@host (host kan IP of hostname zijn)
DEPLOY_SSH=user@example.com

# Pad op server waar de app komt te staan
DEPLOY_DIR=/srv/peblar

# URL waarop de app na deploy bereikbaar moet zijn (voor health check)
DEPLOY_URL=http://example.com:8000

# Optioneel: andere compose file (default = docker-compose.yml)
DOCKER_COMPOSE_FILE=docker-compose.yml
